{
  "name": "jam-frog",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time jam partner overlay for Ableton Live",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.electron.json && node scripts/dev.mjs",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "site": "vite --config vite.site.config.mts",
    "site:build": "vite build --config vite.site.config.mts",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.electron.json"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@fontsource-variable/nunito": "5.2.6",
    "node-osc": "11.7.1"
  }
}
